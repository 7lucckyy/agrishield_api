APP_NAME="AgriShield AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://agrishield.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=agrishield
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=360

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@agrishield.ai
MAIL_FROM_NAME="AgriShield AI"

VOICE_ASSISTANCE_PROVIDER=n_atlas
DIAGNOSIS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_CONNECT_TIMEOUT=10
OPENAI_READ_TIMEOUT=60
NATLAS_CHAT_COMPLETIONS_URL=
NATLAS_API_KEY=
NATLAS_MODEL=NCAIR1/N-ATLaS
NATLAS_CONNECT_TIMEOUT=10
NATLAS_READ_TIMEOUT=90

FARMING_PROVIDER=satyukt
FARMING_CIRCUIT_STORE=redis
FARMING_CIRCUIT_FAILURE_THRESHOLD=5
FARMING_CIRCUIT_COOLDOWN_SECONDS=60
SATYUKT_BASE_URL=
SATYUKT_API_KEY=
SATYUKT_CONNECT_TIMEOUT=10
SATYUKT_READ_TIMEOUT=30

VITE_APP_NAME="AgriShield AI"
