# Copy to .env and run with: fvm flutter run --dart-define-from-file=.env
# Values are compiled into the app, so never put secrets here.

# Base URL of the AgriShield API (must be https for release builds).
API_BASE_URL=https://agrishield.ng/api/v1

# development | staging | production (release builds need staging or production).
APP_ENV=development
