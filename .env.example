APP_NAME="AgriShield AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

VOICE_ASSISTANCE_PROVIDER=n_atlas
VOICE_TRANSCRIPTION_PROVIDER=n_atlas
DIAGNOSIS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_CONNECT_TIMEOUT=10
OPENAI_READ_TIMEOUT=60
NATLAS_CHAT_COMPLETIONS_URL=
NATLAS_API_KEY=
NATLAS_MODEL=NCAIR1/N-ATLaS
NATLAS_ENGLISH_ASR_URL=
NATLAS_HAUSA_ASR_URL=
NATLAS_YORUBA_ASR_URL=
NATLAS_IGBO_ASR_URL=
NATLAS_CONNECT_TIMEOUT=10
NATLAS_READ_TIMEOUT=90

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrishield
DB_USERNAME=agrishield
DB_PASSWORD=agrishield

DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=5432
DB_TEST_DATABASE=agrishield_testing
DB_TEST_USERNAME=agrishield
DB_TEST_PASSWORD=agrishield

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DRIVER=local
# For production private object storage, set PRIVATE_FILESYSTEM_DRIVER=s3
# and configure AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION,
# AWS_BUCKET and optionally AWS_ENDPOINT below.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=360

FARMING_PROVIDER=fake
FARMING_CIRCUIT_STORE=redis
FARMING_CIRCUIT_FAILURE_THRESHOLD=5
FARMING_CIRCUIT_COOLDOWN_SECONDS=60
FAKE_PROVIDER_SEED=1337
FAKE_PROVIDER_LATENCY_MS=0
FAKE_PROVIDER_FAILURE_RATE=0
FAKE_PROVIDER_CHAOS=false
SATYUKT_BASE_URL=
SATYUKT_API_KEY=
SATYUKT_CONNECT_TIMEOUT=10
SATYUKT_READ_TIMEOUT=30

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@agrishield.ai"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
